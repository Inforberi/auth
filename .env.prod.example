# CHECK-ONLY placeholders. Replace credentials before running production.
APP_NAME=auth-prod
APP_ENV=prod
PORT=8080
# Для прямого HTTPS задайте оба пути; иначе TLS завершается на ingress.
HTTP_TLS_CERT_FILE=
HTTP_TLS_KEY_FILE=
# Только доверенный same-site frontend; список — AUTH_ALLOWED_ORIGINS.
AUTH_CORS_ENABLED=false
HTTP_MAX_IN_FLIGHT=128
HTTP_REQUEST_TIMEOUT=10s
# Доверенные CIDR только своего reverse proxy; пусто — заголовки IP игнорируются.
HTTP_TRUSTED_PROXY_CIDRS=
PASSWORD_HASH_CONCURRENCY=2
LOGIN_IP_LIMIT=30
LOGIN_EMAIL_LIMIT=10
LOGIN_GLOBAL_LIMIT=1000
# Telegram OIDC включается отдельно; callback должен быть зарегистрирован в BotFather.
TELEGRAM_LOGIN_ENABLED=false
TELEGRAM_REGISTRATION_ENABLED=false
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=
TELEGRAM_OIDC_REDIRECT_URI=https://auth.example.com/api/v1/auth/telegram/callback
TELEGRAM_LOGIN_IP_LIMIT=30
TELEGRAM_LOGIN_GLOBAL_LIMIT=1000
REGISTER_IP_LIMIT=5
REGISTER_GLOBAL_LIMIT=100
PASSWORD_RESET_GLOBAL_LIMIT=100
LOG_LEVEL=info
SWAGGER_ENABLED=false
SWAGGER_USERNAME=
SWAGGER_PASSWORD=
POSTGRES_IMAGE=postgres:18.6-bookworm
POSTGRES_DB=auth
POSTGRES_USER=auth_owner
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_OWNER_PASSWORD
DATABASE_URL=postgres://auth_runtime:REPLACE_WITH_RANDOM_RUNTIME_PASSWORD@postgres:5432/auth?sslmode=disable
MIGRATION_DATABASE_URL=postgres://auth_owner:REPLACE_WITH_RANDOM_OWNER_PASSWORD@postgres:5432/auth?sslmode=disable&search_path=public
MAX_CONNS=10
MIN_CONNS=2
MAX_CONN_LIFETIME=10m
MAX_CONN_IDLE_TIME=5m
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_RANDOM_REDIS_PASSWORD
SESSION_TTL=168h
ABSOLUTE_SESSION_TTL=336h
SESSION_REFRESH_THRESHOLD=24h
# Срок повторного подтверждения пароля для чувствительных действий, не срок сессии.
SESSION_FRESH_AUTH_TTL=5m
AUTH_ALLOWED_ORIGINS=https://app.example.com
# Retention в днях; фоновая очистка применяет сроки небольшими партиями.
ACCOUNT_EMAIL_RESERVATION_DAYS=30
SESSION_RETENTION_DAYS=30
SECURITY_AUDIT_RETENTION_DAYS=180
RETENTION_BATCH_SIZE=100
RETENTION_INTERVAL=1m
PASSWORD_RESET_TOKEN_TTL=1h
PASSWORD_RESET_URL=https://app.example.com/reset-password
EMAIL_VERIFICATION_URL=https://app.example.com/verify-email
EMAIL_VERIFICATION_TTL=30m
EMAIL_VERIFICATION_RESEND_INTERVAL=1m
EMAIL_CHANGE_ENABLED=false
INVITATIONS_ENABLED=false
INVITATION_URL=https://app.example.com/activate-account
INVITATION_TTL=24h
INVITATION_REISSUE_COOLDOWN=1m
INVITATION_REISSUE_ACTOR_ATTEMPTS_PER_MINUTE=30
INVITATION_REISSUE_PROJECT_ATTEMPTS_PER_MINUTE=100
ACTIVATION_GLOBAL_LIMIT=100

# Временный пароль: отдельный opt-in профиль, без обычной сессии до смены.
TEMPORARY_PASSWORD_ENABLED=false
TEMPORARY_PASSWORD_TTL=24h
TEMPORARY_PASSWORD_SETUP_TTL=10m
TEMPORARY_PASSWORD_REISSUE_COOLDOWN=1m
TEMPORARY_PASSWORD_ISSUE_ACTOR_ATTEMPTS_PER_MINUTE=30
TEMPORARY_PASSWORD_ISSUE_PROJECT_ATTEMPTS_PER_MINUTE=100
TEMPORARY_PASSWORD_SETUP_PROJECT_ATTEMPTS_PER_MINUTE=100
EMAIL_CHANGE_URL=https://app.example.com/change-email
EMAIL_CHANGE_REPORT_URL=https://app.example.com/protect-account
EMAIL_CHANGE_RECOVERY_URL=https://app.example.com/recover-account
EMAIL_CHANGE_RECOVERY_TTL=30m
EMAIL_CHANGE_TTL=30m
EMAIL_CHANGE_PROTECTION_TTL=24h
EMAIL_OUTBOX_KEY=REPLACE_WITH_BASE64_ENCODED_32_RANDOM_BYTES
SMTP_REQUIRE_TLS=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=auth@example.com
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM=auth@example.com
SMTP_DOMAIN=example.com
BACKUP_INTERVAL=24h
BACKUP_RETENTION_COUNT=7
RESTORE_HEALTHCHECK_SQL=SELECT count(*) FROM auth.users;
