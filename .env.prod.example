# CHECK-ONLY placeholders. Replace credentials before running production.
APP_NAME=auth-prod
APP_ENV=prod
PORT=8080
LOG_LEVEL=info
SWAGGER_ENABLED=false
SWAGGER_USERNAME=
SWAGGER_PASSWORD=
POSTGRES_IMAGE=postgres:18.6-bookworm
POSTGRES_DB=auth
POSTGRES_USER=auth_owner
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_OWNER_PASSWORD
DATABASE_URL=postgres://auth_runtime:REPLACE_WITH_RANDOM_RUNTIME_PASSWORD@postgres:5432/auth?sslmode=disable
MIGRATION_DATABASE_URL=postgres://auth_owner:REPLACE_WITH_RANDOM_OWNER_PASSWORD@postgres:5432/auth?sslmode=disable&search_path=public
MAX_CONNS=10
MIN_CONNS=2
MAX_CONN_LIFETIME=10m
MAX_CONN_IDLE_TIME=5m
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_RANDOM_REDIS_PASSWORD
SESSION_TTL=168h
ABSOLUTE_SESSION_TTL=336h
SESSION_REFRESH_THRESHOLD=24h
PASSWORD_RESET_TOKEN_TTL=1h
PASSWORD_RESET_URL=https://app.example.com/reset-password
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=auth@example.com
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM=auth@example.com
SMTP_DOMAIN=example.com
BACKUP_INTERVAL=24h
BACKUP_RETENTION_COUNT=7
RESTORE_HEALTHCHECK_SQL=SELECT count(*) FROM auth.users;
