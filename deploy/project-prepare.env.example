# Только отдельный процесс project-prepare; НЕ добавлять эти secrets в ENV Auth API.
# Сетевые соединения — verify-full, один endpoint; root CA доступен процессу read-only.
# Реальные credentials выдаются отдельно. Пример сам по себе не запускается.
PROVISIONER_REALM_ID=
PROVISIONER_STORAGE_TARGET=primary
# Для -schema -secrets, в том числе с -password. Новый случайный 32-byte base64 master key;
# держать вне БД/репозитория, не переиспользовать EMAIL_OUTBOX_KEY платформы.
PROVISIONER_MASTER_KEY_ID=
PROVISIONER_MASTER_KEY=
PROVISIONER_CATALOG_URL='postgres://auth_platform_preparation:replace-me@catalog.example.test/auth_platform?sslmode=verify-full&sslrootcert=/run/secrets/postgres-ca.pem'
PROVISIONER_STORAGE_URL='postgres://auth_storage_executor:replace-me@storage.example.test/auth_storage?sslmode=verify-full&sslrootcert=/run/secrets/postgres-ca.pem'
