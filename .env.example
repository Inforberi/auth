APP_NAME=auth-dev
APP_ENV=dev
# Необязательный локальный JSON-каталог permissions; шаблоны не создают роли автоматически.
ACCESS_CATALOG_FILE=
# MFA опциональна для пользователя; административные изменения требуют свежую MFA.
# Выключение запрещено при уже подключённых факторах; это не обход защиты.
MFA_ENABLED=false
# Включать только после утверждения проверки владельца и выдачи отдельных DB operator grants.
MFA_RECOVERY_ENABLED=false
MFA_ISSUER=Auth
MFA_LOGIN_CHALLENGE_TTL=5m
# Бюджеты операций в минуту, не пропускная способность сервиса.
MFA_USER_OPERATIONS_PER_MINUTE=5
MFA_IP_OPERATIONS_PER_MINUTE=10
MFA_PROJECT_OPERATIONS_PER_MINUTE=500
PORT=8080
# Для прямого HTTPS задайте оба пути; иначе TLS завершается на ingress.
HTTP_TLS_CERT_FILE=
HTTP_TLS_KEY_FILE=
# Только доверенный same-site frontend; список — AUTH_ALLOWED_ORIGINS.
AUTH_CORS_ENABLED=false
HTTP_MAX_IN_FLIGHT=128
HTTP_REQUEST_TIMEOUT=10s
# Доверенные CIDR только своего reverse proxy; пусто — заголовки IP игнорируются.
HTTP_TRUSTED_PROXY_CIDRS=
PASSWORD_HASH_CONCURRENCY=2
LOGIN_IP_LIMIT=30
LOGIN_EMAIL_LIMIT=10
LOGIN_GLOBAL_LIMIT=1000
# Telegram OIDC: Client ID/Secret из BotFather, не Bot API token. Лимиты общие для start/callback за минуту.
# Client ID/Secret обоих providers — только first-install seed; затем protected settings API.
TELEGRAM_LOGIN_ENABLED=false
TELEGRAM_REGISTRATION_ENABLED=false
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=
TELEGRAM_OIDC_REDIRECT_URI=https://localhost:8443/api/v1/auth/telegram/callback
TELEGRAM_LOGIN_IP_LIMIT=30
TELEGRAM_LOGIN_GLOBAL_LIMIT=1000

# Вход через Google: отдельные включение, регистрация и бюджеты попыток в минуту
GOOGLE_LOGIN_ENABLED=false
GOOGLE_REGISTRATION_ENABLED=false
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
GOOGLE_OIDC_REDIRECT_URI=https://localhost:8443/api/v1/auth/google/callback
GOOGLE_LOGIN_IP_ATTEMPTS_PER_MINUTE=30
GOOGLE_LOGIN_PROJECT_ATTEMPTS_PER_MINUTE=1000

# Одноразовый email-код для входа, не verification и не MFA.
EMAIL_OTP_ENABLED=false
# Подтверждение управления MFA по проверенной почте для аккаунтов без пароля (требует MFA_ENABLED).
EMAIL_REAUTHENTICATION_ENABLED=false
# Первая привязка почты: разрешение администратора + подтверждение владельцем (требует MFA и email reauthentication).
EMAIL_BINDING_ENABLED=false
EMAIL_BINDING_TTL=5m
EMAIL_BINDING_REQUESTS_PER_MINUTE=100
EMAIL_BINDING_CONFIRMATIONS_PER_MINUTE=1000
EMAIL_OTP_TTL=5m
EMAIL_OTP_RESEND_INTERVAL=1m
EMAIL_OTP_REQUEST_PROJECT_ATTEMPTS_PER_MINUTE=100
EMAIL_OTP_CONFIRM_PROJECT_ATTEMPTS_PER_MINUTE=1000
REGISTER_IP_LIMIT=5
REGISTER_GLOBAL_LIMIT=100
PASSWORD_RESET_GLOBAL_LIMIT=100
LOG_LEVEL=debug
SWAGGER_ENABLED=true
SWAGGER_USERNAME=swagger
SWAGGER_PASSWORD=local-swagger
POSTGRES_IMAGE=postgres:18.6-bookworm
POSTGRES_DB=auth
POSTGRES_USER=auth
POSTGRES_PASSWORD=local-auth-only
POSTGRES_PORT=5432
# Первичная настройка: выключена по умолчанию. Включать вместе с MFA_ENABLED.
# INITIAL_SETUP_SECRET — отдельные 32 случайных байта в base64url без padding;
# передаётся оператором только в HTTPS header X-Setup-Token, не в URL или логи.
# После завершения setup закрыт маркером БД; секрет можно удалить и выключить флаг.
INITIAL_SETUP_ENABLED=false
INITIAL_SETUP_SECRET=

DATABASE_URL=postgres://auth:local-auth-only@postgres:5432/auth?sslmode=disable
MIGRATION_DATABASE_URL=postgres://auth:local-auth-only@postgres:5432/auth?sslmode=disable&search_path=public
MAX_CONNS=10
MIN_CONNS=2
MAX_CONN_LIFETIME=10m
MAX_CONN_IDLE_TIME=5m
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=local-redis-only
SESSION_TTL=168h
ABSOLUTE_SESSION_TTL=336h
SESSION_REFRESH_THRESHOLD=24h
# Admin-права: idle продлевает только явное действие UI, не polling; абсолютный срок не продлевается.
ADMIN_SESSION_IDLE_TIMEOUT=30m
ADMIN_SESSION_ABSOLUTE_TTL=12h
ADMIN_SESSION_ACTIVITY_INTERVAL=1m
# Срок повторного подтверждения пароля для чувствительных действий, не срок сессии.
SESSION_FRESH_AUTH_TTL=5m
AUTH_ALLOWED_ORIGINS=https://localhost:8443
# Retention в днях; фоновая очистка применяет сроки небольшими партиями.
ACCOUNT_EMAIL_RESERVATION_DAYS=30
SESSION_RETENTION_DAYS=30
SECURITY_AUDIT_RETENTION_DAYS=180
RETENTION_BATCH_SIZE=100
RETENTION_INTERVAL=1m
PASSWORD_RESET_TOKEN_TTL=1h
PASSWORD_RESET_URL=https://localhost:8443/reset-password
EMAIL_VERIFICATION_URL=https://localhost:8443/verify-email
EMAIL_VERIFICATION_TTL=30m
EMAIL_VERIFICATION_RESEND_INTERVAL=1m
EMAIL_CHANGE_ENABLED=false
INVITATIONS_ENABLED=false
INVITATION_URL=https://localhost:8443/activate-account
INVITATION_TTL=24h
INVITATION_REISSUE_COOLDOWN=1m
INVITATION_ISSUE_ACTOR_ATTEMPTS_PER_MINUTE=30
INVITATION_ISSUE_PROJECT_ATTEMPTS_PER_MINUTE=100
ACTIVATION_GLOBAL_LIMIT=100

# Временный пароль: отдельный opt-in профиль, без обычной сессии до смены.
TEMPORARY_PASSWORD_ENABLED=false
TEMPORARY_PASSWORD_TTL=24h
TEMPORARY_PASSWORD_SETUP_TTL=10m
TEMPORARY_PASSWORD_REISSUE_COOLDOWN=1m
TEMPORARY_PASSWORD_ISSUE_ACTOR_ATTEMPTS_PER_MINUTE=30
TEMPORARY_PASSWORD_ISSUE_PROJECT_ATTEMPTS_PER_MINUTE=100
TEMPORARY_PASSWORD_SETUP_PROJECT_ATTEMPTS_PER_MINUTE=100
EMAIL_CHANGE_URL=https://localhost:8443/change-email
EMAIL_CHANGE_REPORT_URL=https://localhost:8443/protect-account
EMAIL_CHANGE_RECOVERY_URL=https://localhost:8443/recover-account
EMAIL_CHANGE_RECOVERY_TTL=30m
EMAIL_CHANGE_TTL=30m
EMAIL_CHANGE_PROTECTION_TTL=24h
# Только локальный пример; для другого окружения сгенерируйте отдельный случайный ключ.
EMAIL_OUTBOX_KEY=bG9jYWwtb25seS1hdXRoLW91dGJveC1rZXktMzJieXQ=
SMTP_REQUIRE_TLS=false
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=auth@example.com
SMTP_DOMAIN=example.com
# Разрешённые host:port для UI; пусто — только SMTP_HOST:SMTP_PORT. Максимум 16.
SMTP_ALLOWED_TARGETS=
BACKUP_INTERVAL=24h
BACKUP_RETENTION_COUNT=7
RESTORE_HEALTHCHECK_SQL=SELECT count(*) FROM auth.users;
